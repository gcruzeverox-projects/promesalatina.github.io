{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build":       "prisma generate --schema=../../database/schema.prisma && nest build",
    "start":       "node dist/main",
    "start:prod":  "node dist/main",
    "start:dev":   "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "db:generate": "prisma generate --schema=../../database/schema.prisma",
    "db:migrate":  "prisma migrate deploy --schema=../../database/schema.prisma",
    "db:seed":     "ts-node --project tsconfig.json ../../database/seed.ts",
    "lint":        "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test":        "jest",
    "clean":       "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common":           "^10.3.0",
    "@nestjs/core":             "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/jwt":              "^10.2.0",
    "@nestjs/passport":         "^10.0.3",
    "@nestjs/mapped-types":     "^2.0.5",
    "@nestjs/config":           "^3.2.0",
    "@prisma/client":           "5.22.0",
    "@react-pdf/renderer":      "^3.4.4",
    "passport":                 "^0.7.0",
    "passport-jwt":             "^4.0.1",
    "bcryptjs":                 "^2.4.3",
    "cloudinary":               "^2.2.0",
    "multer":                   "^1.4.5-lts.1",
    "resend":                   "^3.2.0",
    "class-validator":          "^0.14.1",
    "class-transformer":        "^0.5.1",
    "reflect-metadata":         "^0.2.2",
    "rxjs":                     "^7.8.1",
    "react":                    "^18.3.0",
    "react-dom":                "^18.3.0"
  },
  "devDependencies": {
    "@nestjs/cli":         "^10.3.2",
    "@nestjs/schematics":  "^10.1.1",
    "@nestjs/testing":     "^10.3.0",
    "@types/bcryptjs":     "^2.4.6",
    "@types/multer":       "^1.4.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/react":        "^18.3.0",
    "prisma":              "5.22.0",
    "ts-node":             "^10.9.2",
    "tsconfig-paths":      "^4.2.0",
    "typescript":          "^5.4.0"
  },
  "prisma": {
    "schema": "../../database/schema.prisma"
  }
}
