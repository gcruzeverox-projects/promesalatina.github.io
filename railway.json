{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "NODE_ENV=development npx --yes pnpm@9 install --no-frozen-lockfile && npx pnpm@9 --filter api build"
  },
  "deploy": {
    "startCommand": "node node_modules/.pnpm/prisma@5.22.0/node_modules/prisma/bin/prisma.js generate --schema=database/schema.prisma; node apps/api/dist/main.js",
    "restartPolicyType": "ON_FAILURE"
  }
}
